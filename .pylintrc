[MASTER]
disable=C0114,C0115,C0116  # Disable docstring warnings since comments are in English but code in Portuguese

[FORMAT]
max-line-length=120

[DESIGN]
max-args=15
max-attributes=15
max-public-methods=20

[MESSAGES CONTROL]
disable=missing-docstring,invalid-name,R0903,R0902,R0913,R0917,W0718,C0415,C0411,W0611,C0301,C0303,C0304,E0611,W0511,R1705,W1309,R0914,W0702,R0911,R0801

[REPORTS]
output-format=colorized