# Application environment: local, development, production
APP_ENV=local

# Database (local / dev / production)
# Local: arquivo .env local usando localhost
# Docker: use db (nome do serviço no docker-compose)
# Production: URL gerenciada (exemplo, do Heroku, Supabase etc)
DATABASE_URL=postgresql://user:password@localhost:5432/financial_control

# Twilio sandbox (for WhatsApp via Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Encryption
CONVERSATION_ENCRYPTION_KEY=your_generated_key_here

# Other configs
SITE_CONFIG_URL=https://your-site.com